# ==============================================================================
# WEALTHOS ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Never commit .env with real credentials.
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="WealthOS Backend API"
APP_VERSION=0.2.0

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:19006"]

# Security & Cryptography Secrets
# Generate random 32-byte secret in production: openssl rand -hex 32
SECRET_KEY=wealthos_local_insecure_development_secret_key_change_in_prod_12345
ENCRYPTION_MASTER_KEY=wealthos_local_32_byte_master_key_for_aes_gcm_123

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wealthos
POSTGRES_USER=wealthos_admin
POSTGRES_PASSWORD=wealthos_local_dev_password_change_in_prod
# Async connection URL for FastAPI & asyncpg
DATABASE_URL=postgresql+asyncpg://wealthos_admin:wealthos_local_dev_password_change_in_prod@localhost:5432/wealthos
# Sync connection URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://wealthos_admin:wealthos_local_dev_password_change_in_prod@localhost:5432/wealthos

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Redis Configuration (Cache & Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Asynchronous Task Queues
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_DEFAULT_QUEUE=default
CELERY_OCR_QUEUE=ocr_heavy
CELERY_MARKET_QUEUE=market_data

# MinIO / Private S3 Object Storage Configuration
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword_local_only
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword_local_only
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=wealthos-documents
MINIO_VAULT_BUCKET=wealthos-vault
STORAGE_REGION=us-east-1

# Web Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
WEB_PORT=3000

# Mobile Application (Expo)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

