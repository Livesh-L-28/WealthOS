# WealthOS Dedicated Staging Environment Configuration
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
APP_NAME="WealthOS Staging API"
APP_VERSION="0.2.0"
RUNTIME_PROFILE=full
REQUIRE_REDIS=true
REQUIRE_STORAGE=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8005
API_V1_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:3005","http://127.0.0.1:3005","http://localhost:3000","http://10.0.2.2:8005"]'

# Staging Database Configuration (Isolated)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wealthos_staging
POSTGRES_USER=wealthos_staging_app
POSTGRES_PASSWORD=wealthos_staging_app_secure_password_2026
POSTGRES_ADMIN_USER=wealthos_admin
POSTGRES_ADMIN_PASSWORD=wealthos_local_dev_password_change_in_prod

# Staging Redis Configuration (DB 10, 11, 12)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=10
REDIS_PASSWORD=wealthos_local_dev_redis_change_in_prod
REDIS_URL=redis://:wealthos_local_dev_redis_change_in_prod@localhost:6379/10
CELERY_BROKER_URL=redis://:wealthos_local_dev_redis_change_in_prod@localhost:6379/11
CELERY_RESULT_BACKEND=redis://:wealthos_local_dev_redis_change_in_prod@localhost:6379/12

# Staging MinIO Object Storage (Dedicated Buckets)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_SECURE=false
STORAGE_DOCUMENTS_BUCKET=wealthos-staging-documents
STORAGE_VAULT_BUCKET=wealthos-staging-vault
STORAGE_QUARANTINE_BUCKET=wealthos-staging-quarantine

# Cryptographic & Auth Secrets
SECRET_KEY=wos_staging_jwt_secret_key_secure_random_hex_32_bytes_2026
ENCRYPTION_MASTER_KEY=wos_staging_aes256_encryption_master_key_32_bytes
